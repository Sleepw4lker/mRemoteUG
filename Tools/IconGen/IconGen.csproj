<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately NOT in mRemoteUG.slnx, and deliberately allowed dependencies the application
    itself may not have. See ADR-0015: the one-PackageReference invariant is on
    src/mRemoteUG/mRemoteUG.csproj, not on the repository. This tool never ships - everything it
    produces is checked in - so nothing here has to be re-evaluated at a framework bump, which is
    the cost that invariant exists to avoid.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IconGen</RootNamespace>
    <AssemblyName>IconGen</AssemblyName>
    <!-- The artwork it emits is versioned by the repository, not by this assembly, so this
         one opts out of the git-derived version in Directory.Build.props and keeps a fixed
         number. Nothing reads it: this tool never ships. -->
    <GitVersioning>false</GitVersioning>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Fluent artwork itself. Microsoft publishes the same SVG geometry that is on GitHub as a
      NuGet package, with one generated type per icon per size carrying the markup in `Content`.
      That matters here beyond convenience: this machine can reach nuget.org and cannot reach
      github.com, so the package is the only route to the art that works offline of GitHub
      (ADR-0013).
    -->
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0" />

    <!--
      Rasterizer. Only SKPath.ParseSvgPathData is used, not an SVG DOM: measured over all 20392
      Regular and Filled icons, the markup is <path d="..."> and essentially nothing else - `fill`
      appears on 1.1% of paths and `stroke` on exactly one - so a path renderer is the whole job
      and the outliers are rejected by name in Validate rather than half-rendered.
    -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

</Project>
