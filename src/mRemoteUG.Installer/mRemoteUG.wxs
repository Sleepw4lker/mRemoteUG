<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?include $(sys.CURRENTDIR)Includes\Config.wxi?>
  <Package Name="$(var.ProductNameWithPlatform)" Manufacturer="$(var.Company)" Version="$(var.ProductVersion)" UpgradeCode="$(var.UpgradeCode)" Language="1033" InstallerVersion="500" ProductCode="$(var.ProductCode)">
    
    <!-- AllowSameVersionUpgrades, because of how the version is built (ADR-0030): between
         releases every build carries the same major.minor.patch and differs only in the fourth
         field, the build number. Windows Installer ignores the fourth field entirely when it
         compares versions, so without this the installer sees the installed package as the same
         version, declines to treat the new one as a major upgrade, and - because ProductCode is
         * and therefore fresh on every build - installs it alongside instead. Two entries in
         Programs and Features, and no upgrade.

         The cost is that downgrade protection stops applying between two builds of the same
         patch: an older rolling build will install over a newer one, because Windows Installer
         considers them equal. Across a release boundary DowngradeErrorMessage still applies.
         This also raises ICE61, which the wixproj suppresses by name. -->
    <MajorUpgrade DowngradeErrorMessage="!(loc.Upgrade_NewerVersionInstalled)" Schedule="afterInstallExecute" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Binary Id="mRemoteUG.Installer.CustomActions.CA.dll" SourceFile="$(var.SolutionDir)src\mRemoteUG.Installer.CustomActions\bin\$(var.Configuration)\mRemoteUG.Installer.CustomActions.CA.dll" />
    <Property Id="MsiLogging" Value="v" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />
    <Property Id="MAINEXE" Value="$(var.ExeProcessName)" />
    <Property Id="INSTALLDIR">
      <RegistrySearch Id="mRemoteUGRegistry" Type="raw" Root="HKLM" Key="Software\mRemoteUG" Name="InstallDir" />
    </Property>
    <Property Id="REQUIREDDOTNETMAJORVERSION" Value="$(var.RequiredDotNetMajorVersion)" />
    <Property Id="REQUIREDDOTNETVERSION" Value="$(var.RequiredDotNetDisplayVersion)" />
    <Property Id="DOTNET_DESKTOP_RUNTIME_INSTALLED" Value="0" Secure="yes" />
    <CustomActionRef Id="SaveCmdlineINSTALLDIR" />


    <!-- LaunchConditions used to be scheduled after the NetFx extension's
         SetWIX_IS_NETFRAMEWORK_40_OR_LATER_INSTALLED action. That extension is no longer used, so
         it now follows the detection actions directly: every property a launch condition reads
         must be set before the conditions are evaluated. -->
    <InstallUISequence>
      <Custom Action="CheckIfDotNetDesktopRuntimeInstalled" After="AppSearch" Condition="NOT Installed" />
      <LaunchConditions After="CheckIfDotNetDesktopRuntimeInstalled" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="CheckIfDotNetDesktopRuntimeInstalled" After="AppSearch" Condition="NOT Installed" />
      <LaunchConditions After="CheckIfDotNetDesktopRuntimeInstalled" />
    </InstallExecuteSequence>
    
    
    <!-- Need to be admin to install -->
    <Launch Condition="Privileged" Message="!(loc.Install_NeedToBeAdminToInstall)" />

    <!-- Minimum operating system: Windows 11.

         VersionNT cannot express that on its own. Windows 10, Windows 11 and Server 2016 and
         newer all report 1000, so the baseline has to be stated as a build number. 22000 is
         Windows 11 first build.

         The build number is read from the registry, not from the WindowsBuild property. Inside
         msiexec.exe, WindowsBuild is 9600 and VersionNT is 603 on every machine: msiexec's
         compatibility manifest declares only the Windows 8.1 supportedOS GUID, so the version
         APIs it calls are shimmed to 6.3.9600. A verbose log of a real install on Windows 11
         26200 shows "Property(S): WindowsBuild = 9600", which is why the previous condition,
         "VersionNT >= 1000 AND WindowsBuild >= 22000" (eb029f0), refused Windows 11 with its
         own message. The measurement behind that condition opened the package through the
         WindowsInstaller COM object from PowerShell, which is manifested for Windows 10, so it
         saw 26200: an in-process session reports the host process's version, and a launch
         condition has to be checked through msiexec.exe.

         CurrentBuildNumber is REG_SZ. Windows Installer converts a property to an integer when
         the other operand is an integer literal: "26200" >= 22000 is True while "19045", ""
         and "abc" are False, so a machine with no readable value is refused, not admitted.
         AppSearch runs the search before LaunchConditions in both sequences.

         A build floor admits Server 2025 (26100), kernel equivalent to Windows 11 24H2, while
         still excluding Server 2022 (20348). Deliberate, and not filtered with MsiNTProductType:
         nothing here needs a client SKU, and a jump host is a real place to install this.

         The Windows 7 conditions this floor replaced, the Service Pack 1 check and the RDP 8.0
         (KB2592687 / KB2830477) and RDP DTLS (KB2574819) update checks, went in e2f3cc8. -->
    <Property Id="WINDOWSCURRENTBUILD">
      <RegistrySearch Id="WindowsCurrentBuildRegistry" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (IGNOREPREREQUISITES = 1) OR (WINDOWSCURRENTBUILD &gt;= 22000)" Message="!(loc.Install_OSVersionRequirement)" />

    <!-- .NET Windows Desktop Runtime, detected by CheckIfDotNetDesktopRuntimeInstalled -->
    <Launch Condition="Installed OR (IGNOREPREREQUISITES = 1) OR DOTNET_DESKTOP_RUNTIME_INSTALLED = 1" Message="!(loc.Install_NeedDotNetDesktopRuntime)" />
    
    

    <Feature Id="F.Complete" Title="!(loc.Feature_Complete)" Display="expand" AllowAdvertise="no" Level="1">
      <Feature Id="F.MinimalFeature" Title="$(var.ProductName)" ConfigurableDirectory="INSTALLDIR" Level="1" AllowAbsent="no">
        <ComponentGroupRef Id="MandatoryComponents" Primary="yes" />
        <ComponentRef Id="C.MainExe" Primary="yes" />
        <ComponentGroupRef Id="CG.ProjectInfoFiles" Primary="yes" />
        <ComponentRef Id="C.RegistryEntries" Primary="yes" />
      </Feature>

      <Feature Id="F.DesktopShortcut" Title="!(loc.Feature_DesktopShortcut)" AllowAdvertise="no" Level="1">
        <ComponentRef Id="C.DesktopShortcut" Primary="yes" />
      </Feature>

      <Feature Id="F.ApplicationStartMenuShortcut" Title="!(loc.Feature_StartMenuShortcut)" AllowAdvertise="no" Level="1">
        <ComponentRef Id="C.ApplicationStartMenuShortcut" Primary="yes" />
      </Feature>
    </Feature>

    <UI>
      <ui:WixUI Id="WixUI_FeatureTree" />
      <UIRef Id="WixUI_ErrorProgressText" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    
    <WixVariable Id="WixUILicenseRtf" Value="Resources\License.rtf" />

    <!-- WixUIBannerBmp and WixUIDialogBmp are deliberately not set. They are overrides, and
         the artwork they used to point at was mRemoteNG's. Left unbound, WixToolset.UI.wixext
         supplies its own bannrbmp.bmp and dlgbmp.bmp, so the dialogs are the stock WiX ones
         rather than blank. Bind them again when this fork has artwork of its own. -->
    
    <!-- Provide option to run app after install -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.FinishPage_LaunchMremoteNow)" />
    <Property Id="WixShellExecTarget" Value="[#MainExeFile]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X86" />
  </Package>
</Wix>