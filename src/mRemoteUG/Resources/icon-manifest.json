{
  // The icon vocabulary of this application. Nothing is artwork unless it is in here.
  // Tools/IconGen turns every row into PNGs (and .ico for window icons) plus Resources.g.cs.
  //
  //   tint "mask"  ships colourless - white RGB, shape in alpha - and is tinted at load
  //   tint "fixed" carries meaning in its colour and is never tinted
  //   note         why this mapping, where it is not obvious. Kept next to the choice.

  // A 16px logical glyph at 100/125/150/175/200/250/300/400% DPI. A request snaps up.
  "ladder": [16, 20, 24, 28, 32, 40, 48, 64],

  // Windows picks one of these itself for the title bar, Alt-Tab and the taskbar.
  "windowIconFrames": [16, 20, 24, 32, 48, 64, 256],

  "glyphs": [
    { "name": "Arrow_Down",            "fluent": "ArrowDown",           "style": "Regular", "tint": "mask" },
    { "name": "Arrow_Up",              "fluent": "ArrowUp",             "style": "Regular", "tint": "mask" },
    { "name": "Chat",                  "fluent": "Comment",             "style": "Regular", "tint": "mask" },
    { "name": "Connection_Add",        "fluent": "Add",       "style": "Regular", "tint": "mask",
      "note": "A bare plus, not a plug: monitor_go already draws PlugConnected, and two menu items with the same mark is worse than a generic one." },
    { "name": "Copy",                  "fluent": "Copy",                "style": "Regular", "tint": "mask" },
    { "name": "Delete",                "fluent": "Delete",              "style": "Regular", "tint": "mask" },
