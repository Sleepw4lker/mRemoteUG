    // Semantic colour. These must NOT follow the theme - an error tinted to the foreground is
    // indistinguishable from a warning. Checked against light and dark Control and Window.
    { "name": "Error",                 "fluent": "ErrorCircle",       "style": "Filled", "tint": "fixed", "color": "#C42B1C" },
    { "name": "ErrorSmall",            "fluent": "ErrorCircle",       "style": "Filled", "tint": "fixed", "color": "#C42B1C" },
    { "name": "Warning",               "fluent": "Warning",           "style": "Filled", "tint": "fixed", "color": "#FFB900" },
    { "name": "WarningSmall",          "fluent": "Warning",           "style": "Filled", "tint": "fixed", "color": "#FFB900" },
    { "name": "Information",           "fluent": "Info",              "style": "Filled", "tint": "fixed", "color": "#0078D4" },
    { "name": "InformationSmall",      "fluent": "Info",              "style": "Filled", "tint": "fixed", "color": "#0078D4" },
    { "name": "ConnectedOverlay",      "fluent": "PresenceAvailable", "style": "Filled", "tint": "fixed", "color": "#107C10",
      "badge": true,
      "note": "Composited onto a connected node icon by StatusImageList.Overlay, so it is generated inset into the corner rather than full-bleed." },
    { "name": "HostStatus_On",         "fluent": "PresenceAvailable", "style": "Filled", "tint": "fixed", "color": "#107C10" },
    { "name": "HostStatus_Off",        "fluent": "PresenceOffline",   "style": "Regular", "tint": "fixed", "color": "#8A8886" },
    { "name": "HostStatus_Check",      "fluent": "PresenceAway",      "style": "Filled", "tint": "fixed", "color": "#F7630C" }
  ],

  // Never tinted: Windows draws these on a title bar this application does not control, so they
  // carry the accent blue, which is legible on both a light and a dark caption.
  "windowIcons": [
    { "name": "App_Icon",                "fluent": "SquareMultiple", "style": "Regular", "tint": "fixed", "color": "#0078D4",
      "note": "The executable icon. SquareMultiple is the mark WinForms itself draws on a Form that sets no Icon, which is what the window and the taskbar were already showing - this puts the same mark on the file, the shortcuts and the Programs and Features entry so they stop disagreeing. Accent blue rather than a mask: an application icon is drawn on a light Explorer background as often as on a dark taskbar." },
    { "name": "Root_Icon",               "fluent": "Home",         "style": "Filled", "tint": "fixed", "color": "#0078D4" },
    { "name": "Info_Icon",               "fluent": "Info",         "style": "Filled", "tint": "fixed", "color": "#0078D4" },
    { "name": "Config_Icon",             "fluent": "Settings",     "style": "Filled", "tint": "fixed", "color": "#0078D4" },
    { "name": "Connections_SaveAs_Icon", "fluent": "Save",         "style": "Filled", "tint": "fixed", "color": "#0078D4" },
    { "name": "Panels_Icon",             "fluent": "LayoutRowTwo", "style": "Filled", "tint": "fixed", "color": "#0078D4" }
  ],

