<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>mRemoteUG.Installer.CustomActions</RootNamespace>
    <AssemblyName>mRemoteUG.Installer.CustomActions</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <!--
      Exception: CustomActions, see "Where this repository departs from these conventions" in
      docs/conventions/csharp.md.

      net472 for WiX DTF, so C# 7.3, which has no nullable syntax: the `enable` setting
      Directory.Build.props applies to the rest of the solution (ADR-0022) is a hard error here,
      so this project turns it off.
    -->
    <Nullable>disable</Nullable>
    <!-- Exception: CustomActions, see "Where this repository departs from these conventions" in
         docs/conventions/csharp.md. Global using directives need C# 10; with ImplicitUsings on,
         the generated GlobalUsings.g.cs fails this project's build with CS8370. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="CustomAction.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
